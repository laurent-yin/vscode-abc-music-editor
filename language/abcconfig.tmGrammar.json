{
    "scopeName": "source.abcconfig",
    "patterns": [
        { "include": "source.abc#literal-block" },
        { "include": "source.abc#templates" },
        { "include": "#directive" },
        { "include": "#comments" },
        { "include": "source.abc#chords" },
        { "include": "source.abc#inline-field" }
    ],
    "repository": {
        "directive": {
            "patterns": [                
                {
                    "match": "^%%.*",
                    "name": "storage"
                }
            ]
        },
        "comments": {
            "patterns": [                
                {
                    "match": "%.*",
                    "name": "comment"
                }
            ]
        }
    }
}